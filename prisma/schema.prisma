// FamilyOS v2 — weekly screen-time economy ("Editorial" design).
// See docs/PRD.md and design_handoff_familyos/ for rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

enum Role {
  PARENT
  KID
}

enum TaskDisplay {
  TALLY // discrete sessions, shown as filled squares (e.g. instrument practice)
  BAR // progress toward a goal, shown as a bar (e.g. homework)
}

enum CompletionStatus {
  PENDING // logged by kid, awaiting parent approval
  APPROVED // parent approved — counts toward the target
  REJECTED // parent rejected — discarded
}

enum LedgerType {
  EARN // target hit → lump-sum minutes
  REDEEM // screen time used
  ADJUST // manual parent +/- bonus
}

enum CelebrationState {
  AVAILABLE // granted, not yet enjoyed
  USED // redeemed by the kid or marked used by a parent
}

model FamilyMember {
  id            String   @id @default(cuid())
  name          String
  role          Role
  // Illustration key for the avatar: tyler | riley | mum
  avatarKey     String
  order         Int      @default(0)
  weeklyCapMins Int      @default(120)
  createdAt     DateTime @default(now())

  tasks       Task[]
  completions Completion[]
  ledger      LedgerEntry[]
  // Persistent (non-weekly) "piggy bank" of celebration tokens — event log.
  celebrationTokens CelebrationToken[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  kind        String // illustration: drum | guitar | book | pencil
  display     TaskDisplay
  targetCount Int // sessions (tally) or steps (bar) to hit the weekly target
  rewardMins  Int // minutes awarded once the target is met
  order       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  kidId String
  kid   FamilyMember @relation(fields: [kidId], references: [id], onDelete: Cascade)

  completions Completion[]
  ledger      LedgerEntry[]

  @@index([kidId])
}

model Completion {
  id         String           @id @default(cuid())
  weekStart  String // ISO date (YYYY-MM-DD) of the week's Monday
  status     CompletionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  approvedAt DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kidId  String
  kid    FamilyMember @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@index([kidId, weekStart])
  @@index([taskId, weekStart, status])
}

model LedgerEntry {
  id        String     @id @default(cuid())
  weekStart String
  type      LedgerType
  minutes   Int // signed: + earn, - redeem, ± adjust
  note      String?
  // EARN only: whether the kid has seen the earn-celebration yet.
  celebrated Boolean   @default(false)
  createdAt DateTime   @default(now())

  kidId String
  kid   FamilyMember @relation(fields: [kidId], references: [id], onDelete: Cascade)

  // Set for EARN entries so a target's reward is granted at most once per week.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([kidId, weekStart])
  // One EARN per task/week (idempotent awards). NULL taskId (REDEEM/ADJUST) is
  // treated as distinct by Postgres, so those remain unconstrained.
  @@unique([kidId, weekStart, taskId])
}

// One row per celebration. `note` is the free-text reason (what it's for).
// Not week-scoped: celebrations accumulate and carry over until used.
model CelebrationToken {
  id        String           @id @default(cuid())
  note      String // free text — what the celebration is for
  state     CelebrationState @default(AVAILABLE)
  createdAt DateTime         @default(now())
  usedAt    DateTime?

  kidId String
  kid   FamilyMember @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@index([kidId, state])
}

model Setting {
  key   String @id
  value String
}
